{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cn-call11",
  "main": "cloudflare/entry.py",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["python_workers"],
  // Production workers.dev URL stays enabled; preview URLs stay disabled.
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_HUB",
        "class_name": "CNCallHub"
      }
    ]
  },
  "exports": {
    "CNCallHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
