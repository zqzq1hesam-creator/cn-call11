{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cn-call11",
  "main": "cloudflare/entry.py",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["python_workers"],
  "keep_vars": true,
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "492fc0815bbf4ee685deb256f5e5b78a"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CALL_HUB",
        "class_name": "CNCallHub"
      }
    ]
  },
  "exports": {
    "CNCallHub": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  }
}
